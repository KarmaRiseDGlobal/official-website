NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (form-to-email delivery)
RESEND_API_KEY=
# Optional: override during testing; defaults to onboarding@resend.dev and hola@karmarisedglobal.com
# RESEND_FROM_EMAIL="KarmaRise D Global <noreply@send.karmarisedglobal.com>"
# CONTACT_TO_EMAIL=hola@karmarisedglobal.com

# Brevo (newsletter contacts & campaigns)
BREVO_API_KEY=
BREVO_LIST_ID=3
# Optional language-specific segment/list IDs in Brevo
BREVO_LIST_ID_EN=6
BREVO_LIST_ID_ES=7
BREVO_WELCOME_TEMPLATE_ID_EN=3
BREVO_WELCOME_TEMPLATE_ID_ES=4
BREVO_FOLDER_NAME="Karmarise contacts"
# Optional sender overrides for Brevo campaign draft generation
# BREVO_SENDER_NAME="KarmaRise D Global"
# BREVO_SENDER_EMAIL=stories@karmarisedglobal.com
# BREVO_REPLY_TO_EMAIL=stories@karmarisedglobal.com
# Optional webhook secret for POST /api/brevo/webhook
# BREVO_WEBHOOK_SECRET=

# Sanity (Stories & Newsletter CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_KEY=
# Optional webhook secret for POST /api/sanity/revalidate and POST /api/sanity/brevo-sync
# SANITY_REVALIDATE_SECRET=
# SANITY_WEBHOOK_SECRET=
