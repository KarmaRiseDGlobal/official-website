NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (form-to-email delivery)
RESEND_API_KEY=
# Required in production (must use a verified domain, never onboarding@resend.dev)
# RESEND_FROM_EMAIL="KarmaRise D Global <noreply@send.karmarisedglobal.com>"
# Fallback recipient if department routing overrides below are not set
# CONTACT_TO_EMAIL=hola@karmarisedglobal.com
# Optional department/topic routing overrides for /api/contact and /api/product-brief
# CONTACT_INQUIRY_EMAIL=inquiry@karmarisedglobal.com
# CONTACT_PARTNERS_EMAIL=partners@karmarisedglobal.com
# CONTACT_STORIES_EMAIL=stories@karmarisedglobal.com

# Brevo (newsletter contacts & campaigns)
BREVO_API_KEY=
BREVO_LIST_ID=3
# Optional language-specific segment/list IDs in Brevo
BREVO_LIST_ID_EN=6
BREVO_LIST_ID_ES=7
BREVO_WELCOME_TEMPLATE_ID_EN=3
BREVO_WELCOME_TEMPLATE_ID_ES=4
BREVO_FOLDER_NAME="Karmarise contacts"
# Optional: set to "false" to disable automated welcome emails during local testing
# BREVO_SEND_WELCOME_EMAIL=true
# Optional sender overrides for Brevo campaign draft generation
# BREVO_SENDER_NAME="KarmaRise D Global"
# BREVO_SENDER_EMAIL=stories@karmarisedglobal.com
# BREVO_REPLY_TO_EMAIL=stories@karmarisedglobal.com
# Required webhook secret for POST /api/brevo/webhook (header: x-brevo-secret or Authorization: Bearer)
BREVO_WEBHOOK_SECRET=

# Sanity (Stories & Newsletter CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_KEY=
# Required webhook secrets for POST /api/sanity/revalidate and POST /api/sanity/brevo-sync (header: x-sanity-secret or Authorization: Bearer)
SANITY_REVALIDATE_SECRET=
SANITY_WEBHOOK_SECRET=

# Cloudflare Turnstile (bot protection on public forms; optional in local dev, recommended in production)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Chatbox (Cloudflare Workers AI)
# Optional override for the Workers AI model (defaults to @cf/meta/llama-3.1-8b-instruct-fp8)
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
# Optional dedicated HMAC secret for signed chat session cookies (falls back to TURNSTILE_SECRET_KEY)
# CHAT_SESSION_SECRET=
